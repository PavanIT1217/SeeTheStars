{
  "appId": "com.webappslab.seethestars",
  "appName": "See the Stars",
  "webDir": "www",
  "backgroundColor": "#04050d",
  "android": {
    "backgroundColor": "#04050d"
  },
  "ios": {
    "backgroundColor": "#04050d",
    "contentInset": "never"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "css",
      "initialViewportFitValueHint": "cover",
      "style": "DARK"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_star",
      "iconColor": "#ffc35a"
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com",
        "apple.com"
      ]
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "swiftToolsVersion": "6.1",
        "packageOptions": {
          "@capacitor-firebase/authentication": {
            "symlink": true
          }
        },
        "packageTraits": {
          "@capacitor-firebase/authentication": [
            "Google"
          ]
        }
      }
    }
  }
}
