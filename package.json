{
  "name": "see-the-stars",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npx http-server -c-1 -p 8080 .",
    "test": "node --test tests/*.test.js",
    "pages": "node scripts/build-pages.mjs",
    "build": "node scripts/build-web.mjs",
    "sync": "npm run build && npx cap sync",
    "android": "npm run sync && npx cap open android",
    "ios": "npm run sync && npx cap open ios",
    "test:rules": "firebase emulators:exec --only firestore --project seethestars-rules-test 'node tests/rules/firestore-rules.test.mjs'"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.5.2",
    "@capacitor/android": "~8.5.3",
    "@capacitor/core": "~8.5.3",
    "@capacitor/ios": "~8.5.3",
    "@capacitor/local-notifications": "^8.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "~8.5.3",
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.0.0"
  },
  "overrides": {
    "@capacitor-firebase/authentication": {
      "firebase": "$firebase"
    }
  }
}
