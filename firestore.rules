rules_version = '2';

// See the Stars: a signed-in grown-up can only read and write their own child's progress.
// Deploy with `firebase deploy --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {
    // users/{uid}/progress/main = { learned, spotted, quiz, log, tours, updatedAt } – explored, spotted, quiz scores, observing log, finished tours
    match /users/{uid}/progress/{doc} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && doc == 'main'
        && request.resource.data.keys().hasOnly(['learned', 'spotted', 'quiz', 'log', 'tours', 'updatedAt'])
        && request.resource.data.learned is map && request.resource.data.learned.size() <= 500
        && request.resource.data.spotted is map && request.resource.data.spotted.size() <= 500
        && request.resource.data.quiz is map && request.resource.data.quiz.size() <= 50
        && (!('log' in request.resource.data) || (request.resource.data.log is list && request.resource.data.log.size() <= 300))
        && (!('tours' in request.resource.data) || (request.resource.data.tours is map && request.resource.data.tours.size() <= 50))
        && request.resource.data.updatedAt is number;
    }
    // Classroom mode. classes/{code} = { owner, name, createdAt }, created by a signed-in grown-up (not anonymous).
    // Students join with the code: classes/{code}/members/{uid} = { nick, explored, spotted, badges, quests, xp, updatedAt },
    // written only by the student's own (anonymous) sign-in; only the teacher and the student can read it.
    match /classes/{code} {
      function isTeacher() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
      allow get: if request.auth != null;
      allow list: if isTeacher() && resource.data.owner == request.auth.uid;
      allow create: if isTeacher()
        && code.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['owner', 'name', 'createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
        && request.resource.data.createdAt is number;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;

      match /members/{uid} {
        function owner() { return get(/databases/$(database)/documents/classes/$(code)).data.owner; }
        allow read: if request.auth != null && (request.auth.uid == uid || owner() == request.auth.uid);
        allow delete: if request.auth != null && (request.auth.uid == uid || owner() == request.auth.uid);
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && exists(/databases/$(database)/documents/classes/$(code))
          && request.resource.data.keys().hasOnly(['nick', 'explored', 'spotted', 'badges', 'quests', 'xp', 'updatedAt'])
          && request.resource.data.nick is string && request.resource.data.nick.size() > 0 && request.resource.data.nick.size() <= 20
          && request.resource.data.explored is int && request.resource.data.explored >= 0 && request.resource.data.explored <= 200
          && request.resource.data.spotted is int && request.resource.data.spotted >= 0 && request.resource.data.spotted <= 200
          && request.resource.data.badges is int && request.resource.data.badges >= 0 && request.resource.data.badges <= 50
          && request.resource.data.quests is int && request.resource.data.quests >= 0 && request.resource.data.quests <= 50
          && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp <= 100000
          && request.resource.data.updatedAt is number;
      }
    }
    // everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
