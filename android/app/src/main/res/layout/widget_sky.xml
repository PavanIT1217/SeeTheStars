<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp">
    <TextView
        android:id="@+id/widget_moon_emoji"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:textSize="34sp" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/widget_moon" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFC35A" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/widget_top" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#F3F5FB" android:textSize="15sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/widget_pass" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#A7AEC4" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
